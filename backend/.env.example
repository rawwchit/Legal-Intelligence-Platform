APP_NAME="Legal Intelligence Platform"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
DATABASE_URL="postgresql+psycopg://localhost/legal_intelligence"
SECRET_KEY="replace-with-a-long-random-value"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
QDRANT_COLLECTION_NAME="legal-intelligence"

# Use this for a no-Docker local Qdrant database.
QDRANT_PATH="storage/qdrant"

# Use this instead when a Qdrant server is available, then remove QDRANT_PATH.
# QDRANT_URL="http://localhost:6333"
